<Window x:Class="DeepClaudeAuto.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeepClaudeAuto.UI.ViewModels"
        Title="DeepClaude Auto Builder"
        Height="700" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DeepClaudeAuto.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="#313244" BorderThickness="0,0,0,1" BorderBrush="#45475A">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="⚡" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="DeepClaude Auto Builder"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#CDD6F4" VerticalAlignment="Center"/>
                <TextBlock Text="  |  Windows 자동 구축 도구"
                           FontSize="13" Foreground="#6C7086" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 마법사 콘텐츠 -->
        <ContentControl Grid.Row="1"
                        Content="{Binding Wizard}"
                        ContentTemplate="{StaticResource WizardTemplate}"
                        Margin="0"/>

        <!-- 하단 내비게이션 -->
        <Border Grid.Row="2" Background="#313244" BorderThickness="0,1,0,0" BorderBrush="#45475A" Padding="20,10">
            <Grid>
                <Button Content="◀ 이전"
                        Command="{Binding Wizard.PrevCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="100"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Wizard.CurrentStepIndex, StringFormat='단계 {0}'}"
                               Foreground="#6C7086" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="/ 5" Foreground="#6C7086" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="다음 ▶"
                        Command="{Binding Wizard.NextCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>
