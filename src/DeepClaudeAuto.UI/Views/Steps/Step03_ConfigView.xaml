<UserControl x:Class="DeepClaudeAuto.UI.Views.Steps.Step03_ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="🔑  Step 3 — API 키 구성"
                       FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock Text="DeepClaude 서버 실행에 필요한 API 키를 입력하세요."
                       FontSize="13" Foreground="#6C7086" Margin="0,4,0,24"/>

            <!-- Anthropic API Key -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Anthropic API Key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="console.anthropic.com 에서 발급"
                               Foreground="#6C7086" FontSize="12" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding AnthropicApiKey, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- DeepSeek API Key -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="DeepSeek API Key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="platform.deepseek.com 에서 발급"
                               Foreground="#6C7086" FontSize="12" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding DeepSeekApiKey, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- 서버 포트 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="서버 포트" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 자동 시작 -->
            <Border Style="{StaticResource CardStyle}">
                <CheckBox IsChecked="{Binding AutoStartServer}"
                          Foreground="#CDD6F4">
                    <TextBlock Text="구축 완료 후 서버 자동 시작" Foreground="#CDD6F4"/>
                </CheckBox>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
