<UserControl x:Class="DeepClaudeAuto.UI.Views.Steps.Step05_BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔨  Step 5 — 서버 빌드"
                       FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock Text="저장소 클론 및 의존성 설치를 진행합니다."
                       FontSize="13" Foreground="#6C7086" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 실시간 로그 -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding LogLines}"
                 Style="{StaticResource LogListBoxStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- 하단 상태 + 버튼 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#6C7086"/>
                <TextBlock Text="✅ 빌드 완료! 다음 단계로 이동하세요."
                           Foreground="#A6E3A1" FontWeight="Bold"
                           Visibility="{Binding BuildCompleted, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소"
                        Command="{Binding StartBuildCancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,10,0" Width="80"/>
                <Button Content="🔨  빌드 시작"
                        Command="{Binding StartBuildCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding IsBuilding, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        Width="130"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
