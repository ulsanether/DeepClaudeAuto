<UserControl x:Class="DeepClaudeAuto.UI.Views.Steps.Step02_InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦  Step 2 — 누락 항목 설치"
                       FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock Text="검사에서 누락된 항목을 자동으로 설치합니다."
                       FontSize="13" Foreground="#6C7086" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 누락 목록 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding FailedItems}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InstallCommand}" Foreground="#6C7086" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 로그 출력 -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding LogLines}"
                 Style="{StaticResource LogListBoxStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- 버튼 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding CurrentTask}" Foreground="#6C7086" VerticalAlignment="Center"/>
            <Button Content="⚡  자동 설치"
                    Command="{Binding InstallAllCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Width="130"/>
        </Grid>
    </Grid>
</UserControl>
