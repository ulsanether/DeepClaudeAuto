<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DeepClaudeAuto.UI.ViewModels"
                    xmlns:steps="clr-namespace:DeepClaudeAuto.UI.ViewModels.Steps"
                    xmlns:views="clr-namespace:DeepClaudeAuto.UI.Views.Steps"
                    xmlns:conv="clr-namespace:DeepClaudeAuto.UI.Converters">

    <!-- Converters -->
    <conv:CheckStatusToBrushConverter   x:Key="StatusToBrush"/>
    <conv:CheckStatusToIconConverter    x:Key="StatusToIcon"/>
    <conv:ServerStatusToBrushConverter  x:Key="ServerStatusToBrush"/>
    <conv:ServerStatusToLabelConverter  x:Key="ServerStatusToLabel"/>
    <conv:BoolToVisibilityConverter     x:Key="BoolToVis"/>
    <conv:BoolToVisibilityConverter     x:Key="InvertBoolToVis"/>

    <!-- Colors -->
    <SolidColorBrush x:Key="SurfaceBrush"   Color="#313244"/>
    <SolidColorBrush x:Key="BaseBrush"      Color="#1E1E2E"/>
    <SolidColorBrush x:Key="TextBrush"      Color="#CDD6F4"/>
    <SolidColorBrush x:Key="SubtextBrush"   Color="#6C7086"/>
    <SolidColorBrush x:Key="AccentBrush"    Color="#89B4FA"/>
    <SolidColorBrush x:Key="GreenBrush"     Color="#A6E3A1"/>
    <SolidColorBrush x:Key="RedBrush"       Color="#F38BA8"/>
    <SolidColorBrush x:Key="YellowBrush"    Color="#F9E2AF"/>

    <!-- Base TextBlock Style -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Primary Button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#1E1E2E"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#B4D0FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#45475A"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#585B70"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Border -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="#313244"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#45475A"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#585B70"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- Log ListBox -->
    <Style x:Key="LogListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="#11111B"/>
        <Setter Property="Foreground" Value="#A6E3A1"/>
        <Setter Property="BorderBrush" Value="#45475A"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- DataTemplate mappings for wizard steps -->
    <DataTemplate DataType="{x:Type steps:ValidationViewModel}">
        <views:Step01_ValidationView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type steps:InstallViewModel}">
        <views:Step02_InstallView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type steps:ConfigViewModel}">
        <views:Step03_ConfigView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type steps:BuildModeViewModel}">
        <views:Step04_BuildModeView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type steps:BuildViewModel}">
        <views:Step05_BuildView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type steps:ServerViewModel}">
        <views:Step06_ServerView/>
    </DataTemplate>

    <!-- WizardTemplate -->
    <DataTemplate x:Key="WizardTemplate" DataType="{x:Type vm:WizardViewModel}">
        <ContentControl Content="{Binding CurrentStep}"/>
    </DataTemplate>

</ResourceDictionary>
